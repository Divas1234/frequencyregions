
\begin{thenomenclature} 
\nomgroup{I}
  \item [{$b$}]\begingroup Index of bus,$b\in[1,2,...,NB]$\nomeqref {17}\nompageref{5}
  \item [{$e$}]\begingroup Index of Battery Electrical Storage System (BESS), $e\in[1,2,...,NE]$\nomeqref {17}\nompageref{5}
  \item [{$g$}]\begingroup Index of conventional generators, $g\in[1,2...,NG]$\nomeqref {17}\nompageref{5}
  \item [{$l$}]\begingroup Index of transmission line, $l\in[1,2,...,NL]$\nomeqref {17}\nompageref{5}
  \item [{$q$}]\begingroup Index of hyperplane, $q\in[1,2,...,NQ]$\nomeqref {19}\nompageref{5}
  \item [{$s$}]\begingroup Index of stochastic scenario, $s\in[1,2,...,NS]$\nomeqref {19}\nompageref{5}
  \item [{$t$}]\begingroup Index of scheduling period, $t\in[1,2,...,NT]$\nomeqref {17}\nompageref{5}
  \item [{$w$}]\begingroup Index of wind farms, $w\in[1,2,...,NW]$\nomeqref {17}\nompageref{5}
  \item [{$z$}]\begingroup Index of unit's production cost blocks, $z\in[1,2,...,NZ]$\nomeqref {19}\nompageref{5}
\nomgroup{P}
  \item [{$\delta t$}]\begingroup discretized time step ($0.05s$ in this paper)\nomeqref {1}\nompageref{3}
  \item [{$\epsilon$}]\begingroup Risk of confidence level\nomeqref {17}\nompageref{5}
  \item [{$\eta_e^{\textrm{dis/ch}}$}]\begingroup Discharging/charging efficiency of BESS $e$\nomeqref {19}\nompageref{5}
  \item [{$\gamma_g^{\textrm{ru/sd}}$}]\begingroup Ramp-up/ramp-down rate of conventional unit $g$\nomeqref {19}\nompageref{5}
  \item [{$\gamma_g^{\textrm{su/sd}}$}]\begingroup Start-up/shut-down capacity of conventional unit $g$\nomeqref {19}\nompageref{5}
  \item [{$\kappa_{l,b}$}]\begingroup Generator-shift-distribution-factor between line $l$ and injected power located at bus $b$\nomeqref {19}\nompageref{5}
  \item [{$\omega_{g}^{(z)}$}]\begingroup Intercept of production cost block $z$ of unit $g$\nomeqref {19}\nompageref{5}
  \item [{$\pi_q$}]\begingroup Probability of sampled residuals\nomeqref {17}\nompageref{5}
  \item [{$\pi_s$}]\begingroup Possibility of stochastic scenario $s$\nomeqref {19}\nompageref{5}
  \item [{$\varDelta f_{\textrm{max}}$}]\begingroup Threshold of frequency nadir\nomeqref {17}\nompageref{5}
  \item [{$\varDelta p_{\textrm{add}}^{E}$}]\begingroup Additional power of BESS\nomeqref {1}\nompageref{3}
  \item [{$\varDelta p_{\textrm{add}}^{G}$}]\begingroup Additional power of conventional units\nomeqref {1}\nompageref{3}
  \item [{$\varDelta p_{\textrm{add}}^{W}$}]\begingroup Additional power of wind farms\nomeqref {1}\nompageref{3}
  \item [{$\varDelta p_{\textrm{step}}$}]\begingroup Mismatch power disturbance\nomeqref {1}\nompageref{3}
  \item [{$c_{g}^{\textrm{up/dw/nl}}$}]\begingroup Shut-up/shut-down/no-load cost of unit $g$\nomeqref {19}\nompageref{5}
  \item [{$D_{g}$}]\begingroup Damping of conventional generators\nomeqref {1}\nompageref{3}
  \item [{$e^{\textrm{VoLL}}$}]\begingroup Risk cost of Value-of-Lost-Load (VoLL)\nomeqref {19}\nompageref{5}
  \item [{$F_g^{z}$}]\begingroup Slope of cost block $z$ of conventional unit $g$\nomeqref {19}\nompageref{5}
  \item [{$F_{g}$}]\begingroup Fraction representing total power generated by turbine of conventional reheated generators\nomeqref {1}\nompageref{3}
  \item [{$K_{g}$}]\begingroup Gain of conventional generators\nomeqref {1}\nompageref{3}
  \item [{$k_{g}^{(z)}$}]\begingroup Slope of operation cost block $z$ of unit $g$\nomeqref {19}\nompageref{5}
  \item [{$M$}]\begingroup A big number\nomeqref {17}\nompageref{5}
  \item [{$M_{e}$}]\begingroup Inertia of BESS $e$\nomeqref {1}\nompageref{3}
  \item [{$M_{g}$}]\begingroup Inertia of conventional generators\nomeqref {1}\nompageref{3}
  \item [{$M_{w}$}]\begingroup Inertia of converters with virtual inertia control\nomeqref {1}\nompageref{3}
  \item [{$p_e^{\textrm{dis/ch, max}}$}]\begingroup Discharging/charging capacity of BESS $e$\nomeqref {19}\nompageref{5}
  \item [{$p_g^{\textrm{min/max}}$}]\begingroup Min/max output of conventional unit $g$\nomeqref {19}\nompageref{5}
  \item [{$p_{l}^{\textrm{max}}$}]\begingroup Capacity of transmission line $l$\nomeqref {19}\nompageref{5}
  \item [{$p_{w,s,t}$}]\begingroup Output of wind farm $w$ at time $t$ under scenario $s$\nomeqref {19}\nompageref{5}
  \item [{$R_{g}$}]\begingroup Droop of conventional generators\nomeqref {1}\nompageref{3}
  \item [{$R_{w}$}]\begingroup Droop of converters with droop control\nomeqref {1}\nompageref{3}
  \item [{$RoCoF_{\textrm{max}}$}]\begingroup Threshold of Rate-of-Change-of-Frequency(RoCoF)\nomeqref {17}\nompageref{5}
  \item [{$t_0$}]\begingroup Initial time of power disturbance\nomeqref {1}\nompageref{3}
  \item [{$T_{E}$}]\begingroup Aggregated time constant of BESS with droop control\nomeqref {1}\nompageref{3}
  \item [{$T_{e}$}]\begingroup Time constant of BESS $e$\nomeqref {1}\nompageref{3}
  \item [{$T_{G,t}$}]\begingroup Aggregated time constant of conventional units\nomeqref {1}\nompageref{3}
  \item [{$T_{g}$}]\begingroup Time constant of conventional generators\nomeqref {1}\nompageref{3}
  \item [{$T_{W}$}]\begingroup Aggregated time constant of converters\nomeqref {1}\nompageref{3}
  \item [{$T_{w}$}]\begingroup Time constant of converters\nomeqref {1}\nompageref{3}
  \item [{$z_q$}]\begingroup Auxiliary binary decision variables\nomeqref {17}\nompageref{5}
\nomgroup{V}
  \item [{$\varDelta p_{d,s,t}$}]\begingroup Forced-load-curtailment at time $t$ under scenario $s$\nomeqref {19}\nompageref{5}
  \item [{$\varDelta p_{w,s,t}$}]\begingroup Wind curtailment at time $t$ under scenario $s$\nomeqref {19}\nompageref{5}
  \item [{$D_{\textrm{equ},t}$}]\begingroup Aggregated equivalent damping at time $t$\nomeqref {1}\nompageref{3}
  \item [{$D_{G,t}$}]\begingroup Aggregated damping of conventional units at time $t$\nomeqref {1}\nompageref{3}
  \item [{$F_{G,t}$}]\begingroup Aggregated fraction of mechanical power generated by conventional reheated units at time $t$\nomeqref {1}\nompageref{3}
  \item [{$K_{G,t}$}]\begingroup Aggregated gain of conventional units at time $t$\nomeqref {1}\nompageref{3}
  \item [{$M_{\textrm{equ},t}$}]\begingroup Aggregated equivalent inertia at time $t$\nomeqref {1}\nompageref{3}
  \item [{$M_{E,t}$}]\begingroup Aggregated inertia of BESS at time $t$\nomeqref {1}\nompageref{3}
  \item [{$M_{G,t}$}]\begingroup Aggregated inertia of conventional units at time $t$\nomeqref {1}\nompageref{3}
  \item [{$M_{W,t}$}]\begingroup Aggregated inertia of converters at time $t$\nomeqref {1}\nompageref{3}
  \item [{$p_{e,s,t}^{\text{dis/ch}}$}]\begingroup Discharge/charge power of BESS $e$ at time $t$ under scenario $s$\nomeqref {19}\nompageref{5}
  \item [{$p_{g,s,t}$}]\begingroup Power of unit $g$ at time $t$ under scenario $s$\nomeqref {19}\nompageref{5}
  \item [{$p_{g,s,t}^{(z)}$}]\begingroup Output of conventional unit $g$ at time $t$ under scenario $s$ corresponding to related cost block $z$\nomeqref {19}\nompageref{5}
  \item [{$R_{G,t}$}]\begingroup Aggregated droop of conventional units at time $t$\nomeqref {1}\nompageref{3}
  \item [{$R_{W,t}$}]\begingroup Aggregated droop of converters at time $t$\nomeqref {1}\nompageref{3}
  \item [{$u_{e,s,t}^{\text{ch}}$}]\begingroup Charge status of BESS at time $t$ under scenario $s$\nomeqref {19}\nompageref{5}
  \item [{$u_{e,s,t}^{\text{dis}}$}]\begingroup Discharge status of BESS at time $t$ under scenario $s$\nomeqref {19}\nompageref{5}
  \item [{$u_{g,t}$}]\begingroup Shut-up decision of conventional unit $g$ at time $t$\nomeqref {19}\nompageref{5}
  \item [{$v_{g,t}$}]\begingroup Shut-down decision of conventional unit $g$ at time $t$\nomeqref {19}\nompageref{5}
  \item [{$x_{g,t}$}]\begingroup Operation status of conventional unit $g$ at time $t$\nomeqref {19}\nompageref{5}

\end{thenomenclature}
