{
  "editor.fontSize": 24,
  "apc.font.family": "Geist Mono",
  "apc.monospace.font.family": "Geist Mono",
  "apc.stylesheet": {},
  "editor.wordWrap": "wordWrapColumn",
  "editor.fontFamily": "Candara, Consolas, 'Courier New', monospace",
  "editor.wordWrapColumn": 200,
  "vim.textwidth": 200,
  "prettier.proseWrap": "always",
  "workbench.editor.wrapTabs": true,
  "notebook.output.wordWrap": true,
  "chat.editor.wordWrap": "on",
  "html.format.wrapLineLength": 180,
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": false,
  "files.autoSaveWorkspaceFilesOnly": false,
  "markdown.extension.print.onFileSave": true,
  "code-runner.saveAllFilesBeforeRun": true,
  "bookmarks.useWorkaroundForFormatters": true,
  "cSpell.words": [
    "FCUC",
    "linearizing",
    "soluted"
  ],
  "editor.tokenColorCustomizations": {
    "textMateRules": [],
    "comments": ""
  },
  "grammarly.selectors": [
    {
      "language": "latex",
      "scheme": "file"
    }
  ],
  "git.ignoreLimitWarning": true
}
