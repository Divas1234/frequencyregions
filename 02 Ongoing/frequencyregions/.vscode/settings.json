    "editor.tokenColorCustomizations": {
        "[GitHub Light Default]": {
            "textMateRules": [
                {
                    "scope": [
                        "comment",
                        "comment.line.number-sign.julia",
                        "comment.block.julia",
                        "punctuation.definition.comment.julia"
                    ],
                    "settings": {
                        "foreground": "#6a737d",
                        "fontStyle": "italic"
                    }
                },
                {
                    "scope": [
                        "keyword.control.julia",
                        "keyword.control.conditional.julia",
                        "keyword.control.loop.julia",
                        "keyword.control.import.julia",
                        "keyword.other.julia",
