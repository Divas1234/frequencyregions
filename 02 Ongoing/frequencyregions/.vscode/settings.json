                        "storage.type.struct.julia",
                        "storage.modifier.julia"
                    ],
                    "settings": {
                        "foreground": "#9558b2",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": [
                        "support.function.macro.julia",
                        "entity.name.function.macro.julia",
                        "variable.other.macro.julia",
                        "meta.macro.julia"
                    ],
                    "settings": {
                        "foreground": "#cb3c33",
                        "fontStyle": "bold"
                    }
