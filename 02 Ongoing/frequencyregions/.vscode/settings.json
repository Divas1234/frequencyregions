                        "foreground": "#4063d8",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": [
                        "entity.name.type.julia",
                        "support.type.julia",
                        "storage.type.julia",
                        "meta.type.julia"
                    ],
                    "settings": {
                        "foreground": "#2c8558",
                        "fontStyle": "italic"
                    }
                },
                {
                    "scope": [
                        "constant.numeric.julia",
                        "constant.language.julia"
                    ],
                    "settings": {
                        "foreground": "#a25c00",
                        "fontStyle": ""
                    }
                },
                {
                    "scope": [
                        "string.quoted.double.julia",
                        "string.quoted.triple.julia",
                        "string.quoted.single.julia",
