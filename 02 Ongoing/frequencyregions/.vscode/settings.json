{
    // --- Julia Language Settings ---
    "julia.executablePath": "",
    "julia.execution.codeInREPL": true,
    // --- Editor Settings ---
    "editor.fontFamily": "JuliaMono, Input, Maple Mono, JetBrains Mono, Geist Mono, Fira Code, Droid Sans Mono, Hack Nerd Font Propo, Google Sans Code, Consolas, 'Courier New', monospace",
    "editor.fontSize": 14,
    "editor.lineNumbers": "on",
    "files.autoSave": "afterDelay",
