[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	ignorecase = true
	precomposeunicode = true
[submodule]
	active = .
[remote "origin"]
	url = https://github.com/Divas1234/frequencyregions.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
	vscode-merge-base = origin/main
[lfs]
	repositoryformatversion = 0
[branch "agents/refactor-code-for-maintainability"]
	vscode-merge-base = origin/main
[branch "agents/refactor-code-structure-maintainability"]
	vscode-merge-base = origin/main
[branch "feature/new-branch"]
	remote = origin
	merge = refs/heads/feature/new-branch
	github-pr-base-branch = "Divas1234#frequencyregions#main"
	vscode-merge-base = origin/feature/new-branch
